{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sji",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sji-portfolio-db"
    }
  ],
  "observability": {
    "enabled": true
  }
}
