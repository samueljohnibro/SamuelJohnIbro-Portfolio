{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sji",
  "main": "./worker/index.js",
  "tsconfig": "./tsconfig.worker.json",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon*",
      "!/icon-192.png",
      "!/apple-touch-icon.png",
      "!/icons.svg",
      "!/site.webmanifest",
      "!/og-image.jpg"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sji-portfolio-db",
      "database_id": "77085a15-2b39-4602-b9d3-df92fc12bccd"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
